generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  username    String   @unique
  email       String   @unique
  nomDePlume  String?  @map("nom_de_plume")
  stampBalance Int    @default(0) @map("stamp_balance")
  stampRefillAt DateTime @default(now()) @map("stamp_refill_at")
  totalStampsEarned Int @default(0) @map("total_stamps_earned")
  createdAt   DateTime @default(now()) @map("created_at")

  // Moderation: a banned user is rejected by getSession; bumping sessionEpoch
  // invalidates their existing sessions immediately.
  bannedAt        DateTime? @map("banned_at")
  banReason       String?   @map("ban_reason")
  bannedByAdminId String?   @map("banned_by_admin_id") @db.Uuid
  sessionEpoch    Int       @default(0) @map("session_epoch")

  posts        Post[]
  interactions PostInteraction[]
  scratches    Scratch[]
  flags        Flag[]
  groups       Group[]
  stamps       Stamp[]
  marginalia   Marginalium[]
  comments     Comment[]

  requestsMade     LetterRequest[] @relation("RequestsMade")
  requestsReceived LetterRequest[] @relation("RequestsReceived")

  guestbookEntries  GuestbookEntry[] @relation("GuestbookOwner")
  guestbookWritings GuestbookEntry[] @relation("GuestbookAuthor")
  robinSections     RoundRobinSection[]

  followers  UserFollow[] @relation("following")
  following  UserFollow[] @relation("follower")

  exchangesStarted Exchange[] @relation("ExchangeUserA")
  exchangesJoined  Exchange[] @relation("ExchangeUserB")

  invitesSent     Invite[] @relation("InvitesSent")
  invitesAccepted Invite[] @relation("InviteAccepted")

  bannedByAdmin AdminUser? @relation("BannedByAdmin", fields: [bannedByAdminId], references: [id])
  warnings      Warning[]
  reportsMade   Report[]   @relation("ReportsByUser")
  paperDesigns  PaperDesign[]
  stampPurchases StampPurchase[]
  stampAdjustments StampAdjustment[]

  @@map("users")
}

// Admin-initiated stamp changes (comps and refund clawbacks) — the audit trail
// for free/returned stamps. amount: positive = granted, negative = removed.
model StampAdjustment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  amount     Int
  kind       String   // comp | refund_clawback
  reason     String?
  purchaseId String?  @map("purchase_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("stamp_adjustments")
}

// A real-money purchase of stamp currency via Stripe Checkout. Credited to the
// buyer's balance when Stripe's webhook confirms payment (idempotent on session).
model StampPurchase {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  packId          String    @map("pack_id")
  stamps          Int
  cents           Int
  stripeSessionId String    @map("stripe_session_id")
  status          String    @default("pending") // pending | completed | refunded
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  refundedAt      DateTime? @map("refunded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([stripeSessionId])
  @@map("stamp_purchases")
}

// User-made stationery paper. The owner pays stamps to create one; it becomes a
// selectable background you write letters on. Public designs can be used by
// anyone (a future paid marketplace can build on this).
model PaperDesign {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  imageUrl  String   @map("image_url")   // internal storage key for the paper texture
  surface   String   @default("letter")  // letter | postcard
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([isPublic])
  @@map("paper_designs")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("user_follows")
}

enum PostType {
  canvas
  photo
}

model Post {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  postType           PostType  @map("post_type")
  canvasStrokeData   Json?     @map("canvas_stroke_data")
  paperType          String?   @map("paper_type")
  inkStyle           String?   @map("ink_style")
  finalImageUrl      String?   @map("final_image_url")
  uploadedPhotoUrl   String?   @map("uploaded_photo_url")
  // Photo postcards (format="photocard"): finalImageUrl is the photo front,
  // backImageUrl is the rendered handwritten note on the back (flippable).
  backImageUrl       String?   @map("back_image_url")
  envelopeData       Json?     @map("envelope_data")
  signatureData      Json?     @map("signature_data")
  stampCount         Int       @default(0) @map("stamp_count")
  recipientId        String?   @map("recipient_id") @db.Uuid
  isPrivate          Boolean   @default(false) @map("is_private")
  needsReview        Boolean   @default(false) @map("needs_review")
  // The author has opted this public-feed letter into the open, crawlable web
  // (share cards, /explore, /l/[id]). Default off — going public is explicit.
  isShowcased        Boolean   @default(false) @map("is_showcased")
  format             String    @default("letter") // letter | postcard
  // Multi-page letters: page 0 lives on this row (finalImageUrl / canvasStrokeData);
  // pages 1..N-1 are PostPage rows. pageCount is the total including page 0.
  pageCount          Int       @default(1) @map("page_count")
  // Slow post: hidden from the recipient until this moment passes
  deliverAt          DateTime? @map("deliver_at")
  // Dead Letter Office: written to no one, waiting to be claimed
  isDeadLetter       Boolean   @default(false) @map("is_dead_letter")
  ocrText            String?   @map("ocr_text")
  ocrHashtags        String[]  @map("ocr_hashtags")
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")
  // When the recipient first opened this letter (each letter has one recipient).
  // Drives the inbox's unopened vs. read piles. Null = still sealed.
  readAt             DateTime? @map("read_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions PostInteraction[]
  scratches    Scratch[]
  flags        Flag[]
  stamps       Stamp[]
  pages        PostPage[]
  reports      Report[]
  replies      Reply[]           @relation("ParentPost")
  childReplies Reply[]           @relation("ChildPost")
  marginalia   Marginalium[]
  comments     Comment[]

  requestAsk         LetterRequest? @relation("RequestAsk")
  requestFulfillment LetterRequest? @relation("RequestFulfillment")
  robinFinal         RoundRobin?

  @@map("posts")
}

enum InteractionType {
  like
}

model PostInteraction {
  postId          String          @map("post_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  interactionType InteractionType @map("interaction_type")
  createdAt       DateTime        @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_interactions")
}

model Scratch {
  id               String   @id @default(uuid()) @db.Uuid
  parentPostId     String   @map("parent_post_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  scratchSvgData   String   @map("scratch_svg_data")
  compositeImageUrl String? @map("composite_image_url")
  createdAt        DateTime @default(now()) @map("created_at")

  parentPost Post @relation(fields: [parentPostId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scratches")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  creatorId   String   @map("creator_id") @db.Uuid
  tagPattern  String   @map("tag_pattern")
  createdAt   DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("groups")
}

enum FlagReason {
  slop
  automated
  hateful
  other
}

model Flag {
  id        String     @id @default(uuid()) @db.Uuid
  postId    String     @map("post_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  reason    FlagReason
  createdAt DateTime   @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("flags")
}

model Stamp {
  id            String    @id @default(uuid()) @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  designId      String    @map("design_id") @db.Uuid
  tier          String
  series        String?
  issueNumber   Int       @map("issue_number")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  spentAt       DateTime? @map("spent_at")
  spentOnPostId String?   @map("spent_on_post_id") @db.Uuid

  owner   User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  design  StampDesign @relation(fields: [designId], references: [id])
  spentOn Post? @relation(fields: [spentOnPostId], references: [id])

  @@map("stamps")
}

model StampDesign {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  imageUrl        String  @map("image_url")
  tier            String
  series          String?
  season          Int?
  totalMinted     Int     @map("total_minted")
  currentlyMinted Int     @map("currently_minted") @default(0)

  stamps Stamp[]

  @@map("stamp_designs")
}

model Reply {
  id           String   @id @default(uuid()) @db.Uuid
  parentPostId String   @map("parent_post_id") @db.Uuid
  // Each reply's child post is created fresh in the same transaction, so it's
  // unique by construction — no DB unique constraint needed (and adding one
  // would make `prisma db push` a destructive, non-interactive-unsafe change).
  childPostId  String   @map("child_post_id") @db.Uuid
  // true = written on the original sheet (annotated); false = a fresh threaded page
  onSheet      Boolean  @default(false) @map("on_sheet")
  createdAt    DateTime @default(now()) @map("created_at")

  parentPost Post @relation("ParentPost", fields: [parentPostId], references: [id], onDelete: Cascade)
  childPost  Post @relation("ChildPost", fields: [childPostId], references: [id], onDelete: Cascade)

  @@index([parentPostId, createdAt])
  @@map("replies")
}

// Letter Exchange: two strangers paired; each writes the other one letter.
// A row with userBId = null is an open seat waiting for a partner.
model Exchange {
  id        String    @id @default(uuid()) @db.Uuid
  userAId   String    @map("user_a_id") @db.Uuid
  userBId   String?   @map("user_b_id") @db.Uuid
  letterAId String?   @map("letter_a_id") @db.Uuid
  letterBId String?   @map("letter_b_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  matchedAt DateTime? @map("matched_at")

  userA User  @relation("ExchangeUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User? @relation("ExchangeUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@map("exchanges")
}

// A handwritten comment on a post — a postscript. Stroke data only, no text.
model Comment {
  id         String    @id @default(uuid()) @db.Uuid
  postId     String    @map("post_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  strokeData Json      @map("stroke_data")
  inkStyle   String    @default("standard") @map("ink_style")
  imageUrl   String    @map("image_url")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

enum LetterRequestStatus {
  open
  fulfilled
  withdrawn
}

// The Request Board: someone pins a handwritten ask addressed to a specific
// member ("draw me a heron"); the member answers with a letter of their own.
model LetterRequest {
  id                String              @id @default(uuid()) @db.Uuid
  requesterId       String              @map("requester_id") @db.Uuid
  requesteeId       String              @map("requestee_id") @db.Uuid
  requestPostId     String              @unique @map("request_post_id") @db.Uuid
  fulfillmentPostId String?             @unique @map("fulfillment_post_id") @db.Uuid
  status            LetterRequestStatus @default(open)
  createdAt         DateTime            @default(now()) @map("created_at")
  fulfilledAt       DateTime?           @map("fulfilled_at")

  requester       User  @relation("RequestsMade", fields: [requesterId], references: [id], onDelete: Cascade)
  requestee       User  @relation("RequestsReceived", fields: [requesteeId], references: [id], onDelete: Cascade)
  requestPost     Post  @relation("RequestAsk", fields: [requestPostId], references: [id], onDelete: Cascade)
  fulfillmentPost Post? @relation("RequestFulfillment", fields: [fulfillmentPostId], references: [id])

  @@map("letter_requests")
}

// A handwritten note left on someone's profile — same medium as a Comment,
// pinned to a person instead of a post.
model GuestbookEntry {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  strokeData Json      @map("stroke_data")
  inkStyle   String    @default("standard") @map("ink_style")
  imageUrl   String    @map("image_url")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  owner  User @relation("GuestbookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  author User @relation("GuestbookAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("guestbook_entries")
}

// Round robin: a letter that passes through several hands, each writer adding
// a band while seeing only a sliver of the previous one. When full, the bands
// are composited into a single public post.
model RoundRobin {
  id          String    @id @default(uuid()) @db.Uuid
  size        Int       @default(3)
  status      String    @default("open") // open | done
  finalPostId String?   @unique @map("final_post_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")

  finalPost Post?               @relation(fields: [finalPostId], references: [id])
  sections  RoundRobinSection[]

  @@map("round_robins")
}

model RoundRobinSection {
  id         String   @id @default(uuid()) @db.Uuid
  robinId    String   @map("robin_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  position   Int
  strokeData Json     @map("stroke_data")
  inkStyle   String   @default("standard") @map("ink_style")
  imageUrl   String   @map("image_url")
  peekUrl    String   @map("peek_url")
  createdAt  DateTime @default(now()) @map("created_at")

  robin RoundRobin @relation(fields: [robinId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([robinId, position])
  @@map("round_robin_sections")
}

model Marginalium {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  svgData   String   @map("svg_data")
  tool      String   @default("red_pen")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("marginalia")
}

// Additional pages of a multi-page letter. Page 0 lives on the Post itself
// (finalImageUrl + canvasStrokeData); these rows are positions 1..N-1.
model PostPage {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  position   Int
  strokeData Json     @map("stroke_data")
  inkStyle   String   @default("standard") @map("ink_style")
  paperType  String?  @map("paper_type")
  imageUrl   String   @map("image_url")
  createdAt  DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@index([postId, position])
  @@map("post_pages")
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

// A friend invitation: the inviter types a recipient's email and handwrites an
// 18th-century postcard. The note is rendered to a postcard image and emailed.
// On acceptance, inviter and new member become mutual friends (follow each other).
model Invite {
  id             String       @id @default(uuid()) @db.Uuid
  inviterId      String       @map("inviter_id") @db.Uuid
  email          String       @map("email")
  token          String       @unique
  strokeData     Json         @map("stroke_data")
  inkStyle       String       @default("standard") @map("ink_style")
  paperType      String?      @map("paper_type")
  imageUrl       String       @map("image_url")
  status         InviteStatus @default(pending)
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  acceptedAt     DateTime?    @map("accepted_at")
  acceptedUserId String?      @map("accepted_user_id") @db.Uuid

  inviter      User  @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedUser User? @relation("InviteAccepted", fields: [acceptedUserId], references: [id])

  @@index([inviterId, createdAt])
  @@map("invites")
}

// ===================== Admin panel =====================

model AdminUser {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  displayName        String?   @map("display_name")
  passwordHash       String    @map("password_hash")        // argon2id
  totpSecret         String?   @map("totp_secret")          // AES-256-GCM at rest
  totpEnabledAt      DateTime? @map("totp_enabled_at")
  pendingTotpSecret  String?   @map("pending_totp_secret")  // AES-256-GCM
  lastTotpStep       Int?      @map("last_totp_step")       // anti-replay
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  enrollToken        String?   @map("enroll_token")         // argon2 hash of one-time CLI enroll token
  enrollTokenExpires DateTime? @map("enroll_token_expires")
  lastLoginAt        DateTime? @map("last_login_at")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  recoveryCodes   AdminRecoveryCode[]
  sessions        AdminSession[]
  bansIssued      User[]      @relation("BannedByAdmin")
  warningsIssued  Warning[]   @relation("WarningByAdmin")
  reportsResolved Report[]    @relation("ReportResolvedByAdmin")
  auditEntries    AdminAudit[]

  @@map("admin_users")
}

model AdminRecoveryCode {
  id           String    @id @default(uuid()) @db.Uuid
  adminUserId  String    @map("admin_user_id") @db.Uuid
  lookupPrefix String    @map("lookup_prefix") // first 4 chars, indexed (single-candidate verify)
  codeHash     String    @map("code_hash")     // argon2id
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, lookupPrefix, usedAt])
  @@map("admin_recovery_codes")
}

model AdminSession {
  id                String    @id @default(uuid()) @db.Uuid // == JWT sid
  adminUserId       String    @map("admin_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  lastActivityAt    DateTime  @default(now()) @map("last_activity_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at") // now + 2h, never extended
  revokedAt         DateTime? @map("revoked_at")
  ip                String?
  userAgent         String?   @map("user_agent")
  csrfSecret        String    @map("csrf_secret")

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

enum ReportTargetType {
  post
  user
}

enum ReportReason {
  slop
  automated
  hateful
  harassment
  spam
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  postId     String?          @map("post_id") @db.Uuid // server-set from lookup, never copied from client
  reason     ReportReason
  note       String?          // <=240, admin-only, escaped on render
  status     ReportStatus     @default(open)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  resolvedByAdminId String?   @map("resolved_by_admin_id") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at")
  resolutionNote    String?   @map("resolution_note")

  reporter        User       @relation("ReportsByUser", fields: [reporterId], references: [id], onDelete: Cascade)
  post            Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  resolvedByAdmin AdminUser? @relation("ReportResolvedByAdmin", fields: [resolvedByAdminId], references: [id])
  warnings        Warning[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model Warning {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  adminId        String    @map("admin_id") @db.Uuid
  reason         String
  reportId       String?   @map("report_id") @db.Uuid
  acknowledgedAt DateTime? @map("acknowledged_at")
  emailedAt      DateTime? @map("emailed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin  AdminUser @relation("WarningByAdmin", fields: [adminId], references: [id])
  report Report?   @relation(fields: [reportId], references: [id])

  @@index([userId, createdAt])
  @@map("warnings")
}

enum AdminAuditAction {
  login_success
  login_failure
  post_delete
  post_restore
  image_delete
  user_warn
  user_ban
  user_unban
  report_resolve
  report_dismiss
  db_maintenance
  backup_download
  admin_enroll_totp
  admin_recovery_used
}

model AdminAudit {
  id         String           @id @default(uuid()) @db.Uuid
  adminId    String?          @map("admin_id") @db.Uuid
  action     AdminAuditAction
  targetType String?          @map("target_type")
  targetId   String?          @map("target_id")
  detail     Json?            // redacted allowlist only
  ip         String?
  userAgent  String?          @map("user_agent")
  createdAt  DateTime         @default(now()) @map("created_at")

  admin AdminUser? @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit")
}
